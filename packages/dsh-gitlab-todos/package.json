{
  "name": "dsh-gitlab-todos",
  "version": "0.1.3",
  "description": "GitLab Todo polling and Web sidebar for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/index.d.mts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack": "pnpm pack --pack-destination dist"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-brand": "0.0.1-rc.1",
    "@deepseek-ai/dsh-credentials": "0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "22.20.0",
    "@types/react": "~18.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
