  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "22.20.0",
    "typescript": "7.0.2",
    "tsdown": "0.22.14",
    "vitest": "4.1.11"
  }
}
