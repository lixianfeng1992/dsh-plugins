{
  "name": "dsh-session-reporting",
  "version": "0.1.7",
  "description": "Persist complete DeepSeek Harness sessions in PostgreSQL",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
    ,"./client": {
      "types": "./lib/index.d.mts",
      "default": "./lib/client.js"
    }
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "docker-compose.yml", "schema.sql"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-connection"]
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack": "pnpm pack --pack-destination dist"
  },
  "dependencies": {
    "pg": "^8.16.3"
    ,"lucide-react": "^0.468.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4 <5",
    "@deepseek-ai/dsh-anonymous-user-id": ">=0.1 <1",
    "@deepseek-ai/dsh-session": ">=0.1 <1",
    "@deepseek-ai/dsh-client-connection": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.0.1-rc.1 <1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@types/node": "22.20.0",
    "@types/pg": "^8.15.5",
    "@types/react": "~18.3.1",
    "lucide-react": "^0.468.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
