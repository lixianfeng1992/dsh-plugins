{
  "name": "dsh-native-agents",
  "version": "0.1.4",
  "description": "Continuable Codex and Claude Code agents for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/index.d.mts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack": "pnpm pack --pack-destination dist"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-protocol": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.1 <1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.1 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.1 <1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.1 <1",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.1 <1",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.1 <1",
    "@deepseek-ai/dsh-tool-subagent": ">=0.1.0-rc.1 <1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-client-runtime": "link:../../../deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-home-paths": "link:../../../deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-llm": "link:../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-subagent": "link:../../../deepseek-harness/packages/subagent/subagent",
    "@deepseek-ai/dsh-subprocess": "link:../../../deepseek-harness/packages/subprocess/subprocess",
    "@deepseek-ai/dsh-tool-subagent": "link:../../../deepseek-harness/packages/subagent/tool-subagent",
    "@types/node": "22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
